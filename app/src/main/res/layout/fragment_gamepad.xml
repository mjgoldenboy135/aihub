<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- TOP BAR: L2 | L1 ···· SEL HOME START ···· R1 | R2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <Button
            android:id="@+id/btnL2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.4"
            android:text="L2"
            android:textSize="13sp"
            android:backgroundTint="@color/key_background"
            android:textColor="@color/white"
            android:focusable="false"
            android:padding="0dp"
            android:layout_marginEnd="2dp"/>

        <Button
            android:id="@+id/btnL1"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="L1"
            android:textSize="13sp"
            android:backgroundTint="@color/key_background"
            android:textColor="@color/white"
            android:focusable="false"
            android:padding="0dp"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnSelect"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="0.8"
            android:text="SEL"
            android:textSize="10sp"
            android:backgroundTint="#1E1E1E"
            android:textColor="@color/text_secondary"
            android:focusable="false"
            android:padding="0dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="0.9"
            android:text="&#x2302;"
            android:textSize="20sp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/black"
            android:focusable="false"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="0.8"
            android:text="START"
            android:textSize="10sp"
            android:backgroundTint="#1E1E1E"
            android:textColor="@color/text_secondary"
            android:focusable="false"
            android:padding="0dp"
            android:layout_marginStart="4dp"/>

        <Button
            android:id="@+id/btnR1"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="R1"
            android:textSize="13sp"
            android:backgroundTint="@color/key_background"
            android:textColor="@color/white"
            android:focusable="false"
            android:padding="0dp"
            android:layout_marginStart="6dp"/>

        <Button
            android:id="@+id/btnR2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.4"
            android:text="R2"
            android:textSize="13sp"
            android:backgroundTint="@color/key_background"
            android:textColor="@color/white"
            android:focusable="false"
            android:padding="0dp"
            android:layout_marginStart="2dp"/>

    </LinearLayout>

    <!-- MAIN BODY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- LEFT: Left Joystick (top) + D-Pad (bottom) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <com.bluekey.ui.views.JoystickView
                android:id="@+id/joystickLeft"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"/>

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="3"
                android:layout_gravity="center"
                android:layout_marginTop="10dp">

                <View android:layout_width="46dp" android:layout_height="46dp"/>

                <Button
                    android:id="@+id/btnDpadUp"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:text="&#x25B2;"
                    android:textSize="14sp"
                    android:backgroundTint="@color/key_background"
                    android:textColor="@color/white"
                    android:focusable="false"
                    android:padding="0dp"/>

                <View android:layout_width="46dp" android:layout_height="46dp"/>

                <Button
                    android:id="@+id/btnDpadLeft"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:text="&#x25C4;"
                    android:textSize="14sp"
                    android:backgroundTint="@color/key_background"
                    android:textColor="@color/white"
                    android:focusable="false"
                    android:padding="0dp"/>

                <View android:layout_width="46dp" android:layout_height="46dp"/>

                <Button
                    android:id="@+id/btnDpadRight"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:text="&#x25BA;"
                    android:textSize="14sp"
                    android:backgroundTint="@color/key_background"
                    android:textColor="@color/white"
                    android:focusable="false"
                    android:padding="0dp"/>

                <View android:layout_width="46dp" android:layout_height="46dp"/>

                <Button
                    android:id="@+id/btnDpadDown"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:text="&#x25BC;"
                    android:textSize="14sp"
                    android:backgroundTint="@color/key_background"
                    android:textColor="@color/white"
                    android:focusable="false"
                    android:padding="0dp"/>

                <View android:layout_width="46dp" android:layout_height="46dp"/>

            </GridLayout>

        </LinearLayout>

        <!-- RIGHT: ABXY Diamond (top) + Right Joystick (bottom) — mirrors left side -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="3"
                android:layout_gravity="center">

                <View android:layout_width="50dp" android:layout_height="50dp"/>

                <Button
                    android:id="@+id/btnY"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:text="Y"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="#FFC107"
                    android:textColor="@color/black"
                    android:focusable="false"
                    android:padding="0dp"/>

                <View android:layout_width="50dp" android:layout_height="50dp"/>

                <Button
                    android:id="@+id/btnX"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:text="X"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="#2196F3"
                    android:textColor="@color/white"
                    android:focusable="false"
                    android:padding="0dp"/>

                <View android:layout_width="50dp" android:layout_height="50dp"/>

                <Button
                    android:id="@+id/btnB"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:text="B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="#F44336"
                    android:textColor="@color/white"
                    android:focusable="false"
                    android:padding="0dp"/>

                <View android:layout_width="50dp" android:layout_height="50dp"/>

                <Button
                    android:id="@+id/btnA"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:text="A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="#4CAF50"
                    android:textColor="@color/white"
                    android:focusable="false"
                    android:padding="0dp"/>

                <View android:layout_width="50dp" android:layout_height="50dp"/>

            </GridLayout>

            <com.bluekey.ui.views.JoystickView
                android:id="@+id/joystickRight"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
