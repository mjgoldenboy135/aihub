<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect via Bluetooth"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Make your device discoverable, then pair from your host device's Bluetooth settings."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <!-- Make Discoverable button -->
    <Button
        android:id="@+id/btnMakeDiscoverable"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Make Discoverable (300s)"
        android:backgroundTint="@color/primary"
        android:textColor="@color/black"
        android:textSize="14sp"/>

    <!-- Countdown timer -->
    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <!-- Paired devices header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Paired Devices"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnRefreshDevices"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Refresh"
            android:textSize="12sp"
            android:backgroundTint="@color/surface"
            android:textColor="@color/primary"/>
    </LinearLayout>

    <!-- No paired devices hint -->
    <TextView
        android:id="@+id/tvNoPairedDevices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No paired devices found. Pair from your host device first."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone"/>

    <!-- Bonded devices list -->
    <ListView
        android:id="@+id/listBondedDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/surface"
        android:dividerHeight="1dp"/>

    <!-- Connection status bar at bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvConnectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Not connected"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="8dp"/>

</LinearLayout>
